#!/bin/bash
set -e

cd "$(dirname "$0")"
find ../ ../html -type f \( -name "*.js" -o -name "*.css" -o -name "*.html" -o -name "*.json" \) -exec chmod -x {} +
echo -e "\n"

# Initial setup
if [[ "$1" == "install" ]]; then
    uuid=$(python3 -c "import uuid; print(uuid.uuid4())")
    sudo xargs -a ../packages.txt apt install -y
    sudo mkdir -v -p /etc/rpiNode
    sudo mkdir -v -p /srv/rpiNode
    sudo mkdir -v -p /srv/rpiNode/html
    echo -e "\n"
    sudo cp -v ../html/*.* /srv/rpiNode/html/
    if [ -f "/etc/rpiNode/config.json" ]; then
        timestamp=$(date +%Y%m%d%H%M%S)
        sudo cp -v /etc/rpiNode/config.json "/etc/rpiNode/config.json-$timestamp"
    fi    
    sudo cp -v ../default-config.json /etc/rpiNode/config.json
    sudo sed -i "s/rpiNode-id-notset/$uuid/g" /etc/rpiNode/config.json
    echo -e "\n"
fi

# -- tmp for development use --
if [[ "$1" == "update" ]]; then
    sudo cp -v ../html/*.* /srv/rpiNode/html/
fi

# -- tmp for development use --
if [[ "$1" == "update-only" ]]; then
    sudo cp -v ../html/*.* /srv/rpiNode/html/
    false 
fi

# Check for "debug" argument
CFLAGS="-Wall"
LDFLAGS="-Wall -pthread -lsqlite3 -lmicrohttpd -ljansson $(pkg-config --cflags --libs avahi-client) -lm"

if [[ "$1" == "debug" ]]; then
    echo "Debug mode enabled"
    CFLAGS="$CFLAGS -g"
    LDFLAGS="-g $LDFLAGS"
fi

# Map source files to desired object files
declare -A FILE_MAP=(
    [main.c]=main.o
    [client/clientRouteInput.c]=clientRouteInput.o
    [config/configHelpers.c]=configHelpers.o
    [config/configFileRead.c]=configFileRead.o
    [config/configDataModules.c]=configDataModules.o
    [config/configFileCompleted.c]=configFileCompleted.o
    [data/dataFree.c]=dataFree.o
    [db/dbInitalize.c]=dbInitalize.o
    [db/dbWriteTags.c]=dbWriteTags.o
    [db/dbSaveValuesThread.c]=dbSaveValuesThread.o
    [network/http/httpServeThread.c]=httpServeThread.o
    [network/http/httpRouteRequest.c]=httpRouteRequest.o
    [network/http/handlers/httpHandleFile.c]=httpHandleFile.o
    [network/http/httpAnswerConnection.c]=httpAnswerConnection.o
    [network/http/httpQueueErrorResponse.c]=httpQueueErrorResponse.o
    [network/http/handlers/httpHandleStatus.c]=httpHandleStatus.o
    [network/mDNS/mDnsPublishService.c]=mDnsPublishService.o
    [network/mDNS/mDnsScanCallbacks.c]=mDnsScanCallbacks.o
    [network/mDNS/mDnsScanUpdateList.c]=mDnsScanUpdateList.o
    [network/mDNS/mDnsScanServiceThread.c]=mDnsScanServiceThread.o
    [sensors/DS18B20/readSlave.c]=readSlave.o
    [sensors/MPU6050/readMPU6050.c]=readMPU6050.o
    [sensors/DS18B20/readDS18B20.c]=readDS18B20.o
    [sensors/MPU6050/assignValues.c]=assignValues.o
    [sensors/MPU6050/calculateAngles.c]=calculateAngles.o
    [sensors/DS18B20/scanForW1Devices.c]=scanForW1Devices.o
    [sensors/MPU6050/smoothingMovingAverage.c]=smoothingMovingAverage.o
    [service/serviceLaunchThreads.c]=serviceLaunchThreads.o
    [utils/sleepMs.c]=sleepMs.o
    [utils/readFile.c]=readFile.o
    [utils/setTmpfs.c]=setTmpfs.o
    [utils/nameValue.c]=nameValue.o
    [utils/updateTags.c]=updateTags.o
    [utils/strReplace.c]=strReplace.o
    [utils/getTimeStamp.c]=getTimeStamp.o
    [utils/signalHandler.c]=signalHandler.o
    [utils/getLineFromCmd.c]=getLineFromCmd.o
    [utils/getLocalIPList.c]=getLocalIPList.o
    [utils/setSharedValue.c]=setSharedValue.o
)

OBJ_FILES=()

echo "Compiling source files..."

for src in "${!FILE_MAP[@]}"; do
    obj="${FILE_MAP[$src]}"
    gcc -c $CFLAGS "$src" -o "$obj" $(pkg-config --cflags avahi-client)
    OBJ_FILES+=("$obj")
done

echo "Linking..."
gcc "${OBJ_FILES[@]}" -o ../rpiNode $LDFLAGS

echo "Cleaning up..."
rm -f *.o
find . -type f \( -name "*.c" -o -name "*.h" -o -name "*.txt" \) -exec chmod -x {} +

echo "Build complete!"
echo -e "\n"

#---------------------------------------
# TO-BE REMOVED Soon TM ----------------
#---------------------------------------
if [ "$1" == "run-mem" ]; then
    sudo valgrind --suppressions=valgrind.supp ../rpiNode --service
fi

if [[ "$1" == "run" ]]; then
    sudo ../rpiNode --service
fi
